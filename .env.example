# Copy to `.env.local` and fill in. Every value here is a placeholder — never
# commit a real token. `.gitignore` ignores `.env*` and negates this one file.

# --- Sanity (required) -------------------------------------------------------
# src/sanity/env.ts throws on startup if either of these is missing.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
# "dev" is authored against; "prod" is what the deployed site reads.
NEXT_PUBLIC_SANITY_DATASET="dev"
# Optional; defaults to the date pinned in src/sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=""
# Read-only token. src/sanity/lib/live.ts throws immediately at runtime without
# it. Cannot mutate — Sanity Manage → API → Add New Token, "Viewer".
SANITY_API_READ_TOKEN=""
# Shared secret for the /api/revalidate-tag webhook. Any random string; set the
# same value on the Sanity webhook.
SANITY_REVALIDATE_SECRET=""

# --- Site --------------------------------------------------------------------
# No trailing slash. Canonicals, JSON-LD, robots.txt and all three sitemaps
# build absolute URLs from this, so it must be set or they break.
SITE_URL="http://localhost:3001"

# --- Shopify (all optional) --------------------------------------------------
# Without a store domain plus a Storefront token the integration no-ops and
# products render from the manual Sanity fields. Full walkthrough:
# docs/SHOPIFY-SETUP.md
SHOPIFY_STORE_DOMAIN=""
# Prefer the private token (Headless channel) — the public one below is
# throttled per buyer IP. Only one is needed.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=""
SHOPIFY_STOREFRONT_API_TOKEN=""
# Optional; defaults to the version pinned in src/lib/shopify/client.ts.
SHOPIFY_API_VERSION=""
# Verifies the HMAC on /api/shopify/revalidate. Required only if you register
# the product/inventory webhooks.
SHOPIFY_WEBHOOK_SECRET=""

# --- Email (contact form, product submission, back-in-stock) -----------------
EMAIL_DISPLAY_NAME="Blackwater RC"
EMAIL_SERVER_USER=""
# For Gmail this is an app password, not the account password:
# https://security.google.com/settings/security/apppasswords
EMAIL_SERVER_PASSWORD=""
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="465"

# --- Klaviyo (newsletter + back-in-stock) ------------------------------------
# Private API key: Klaviyo → Settings → API Keys. Both routes log an error and
# fail soft when it is unset.
KLAVIYO_PRIVATE_API_KEY=""

# --- One-shot scripts only ---------------------------------------------------
# Never read by the app. Needed only by ad-hoc data scripts that mutate a
# dataset; see migrations/README.md.
SANITY_READ_WRITE_TOKEN=""
